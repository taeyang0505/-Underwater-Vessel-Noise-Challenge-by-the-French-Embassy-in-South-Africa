  "semantic_cautions": [
    "No single confirmed-outlier percentage follows from overlapping screening rules, boundary candidates and nominal hardware warnings.",
    "653 sentinel rows are marked invalid_measurement_keep_row; incomplete/off-clock rows are unsuitable for full-ish minute alignment, not necessarily corrupted recordings.",
    "12643 boundary candidates are statistical run-edge flags with unverified physical cause; 6777 are already in original fixed windows.",
    "136518 URN rows carry a nominal Nyquist metadata warning, not proven measurement failure or deletion authorization.",
    "Low spectral spread, high dB, high energy fraction and valid high target shares are not automatically errors.",
    "duration_lt5 is a descriptive bin (1 to under5 seconds here), not a preexisting severe-error flag or a newly adopted rule.",
    "Whole-window boundary exclusion leaves zero TRAIN windows for Cape_Recife and Riy_Banks in every fold; this may reduce domain support, but a performance cause has not been measured.",
    "Further exclusion has not been evaluated in this audit; lower RMSE or better official performance is not established.",
    "Reserved source roles and temporal purge are separation rules, not outlier removal. All original rows remain retained."
  ],
  "reproduction_expressions": {
    "invalid": "(~m.qc_25band_finite | m.sentinel_like).sum()",
    "screen": "(~m.qc_25band_finite | m.sentinel_like | ~m.dur.between(55,65) | m.t.dt.second.gt(5)).sum()",
    "boundary_in_windows": "(m.row_id.isin(flags.row_id) & m.window_included).sum()",
    "train_exclusion": "b.loc[b.parent_split.eq(\"train\"), \"boundary_candidate_flag\"].sum() / b.parent_split.eq(\"train\").sum()",
    "overlap_union": "(mask_a & mask_b).sum(); (mask_a | mask_b).sum()"
  },
